[
  {
    "id": "tab_smart_campus",
    "type": "tab",
    "label": "Smart Campus IoT",
    "disabled": false,
    "info": "Smart Campus IoT Simulation Dashboard"
  },
  {
    "id": "mqtt_broker_hivemq",
    "type": "mqtt-broker",
    "name": "HiveMQ Public Broker",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "node-red-smart-campus-dashboard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ui_tab_campus",
    "type": "ui_tab",
    "name": "Smart Campus",
    "icon": "dashboard",
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui_group_latest",
    "type": "ui_group",
    "name": "Latest Telemetry",
    "tab": "ui_tab_campus",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_group_alerts",
    "type": "ui_group",
    "name": "Alerts",
    "tab": "ui_tab_campus",
    "order": 2,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_group_chart",
    "type": "ui_group",
    "name": "Temperature Trend",
    "tab": "ui_tab_campus",
    "order": 3,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_smart_campus",
    "name": "Campus Telemetry",
    "topic": "campus/+/+/+/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 100,
    "wires": [["fn_prepare_dashboard"]]
  },
  {
    "id": "fn_prepare_dashboard",
    "type": "function",
    "z": "tab_smart_campus",
    "name": "Prepare dashboard values",
    "func": "const p = msg.payload;\nif (!p || typeof p !== 'object') { return null; }\nconst alerts = [];\nif (p.temperature > 35) alerts.push('High temperature');\nif (p.occupancy === 0 && p.light_level > 60) alerts.push('Empty room with lights on');\nif (p.air_quality > 120) alerts.push('Poor air quality');\nif (p.humidity > 80) alerts.push('Abnormal humidity');\nconst label = `${p.deviceId} (${p.room})`;\nreturn [\n    { payload: Number(p.temperature), topic: label },\n    { payload: Number(p.humidity), topic: label },\n    { payload: Number(p.occupancy), topic: label },\n    { payload: alerts.length ? `${label}: ${alerts.join(', ')}` : `${label}: No active alerts` },\n    { payload: Number(p.temperature), topic: label }\n];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [
      ["gauge_temperature"],
      ["gauge_humidity"],
      ["gauge_occupancy"],
      ["text_alerts"],
      ["chart_temperature"]
    ]
  },
  {
    "id": "gauge_temperature",
    "type": "ui_gauge",
    "z": "tab_smart_campus",
    "name": "Latest temperature",
    "group": "ui_group_latest",
    "order": 1,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Temperature",
    "label": "C",
    "format": "{{value}}",
    "min": 0,
    "max": 50,
    "colors": ["#2ca02c", "#ffbf00", "#d62728"],
    "seg1": "30",
    "seg2": "35",
    "x": 650,
    "y": 40,
    "wires": []
  },
  {
    "id": "gauge_humidity",
    "type": "ui_gauge",
    "z": "tab_smart_campus",
    "name": "Latest humidity",
    "group": "ui_group_latest",
    "order": 2,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Humidity",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": ["#2ca02c", "#ffbf00", "#d62728"],
    "seg1": "60",
    "seg2": "80",
    "x": 640,
    "y": 90,
    "wires": []
  },
  {
    "id": "gauge_occupancy",
    "type": "ui_gauge",
    "z": "tab_smart_campus",
    "name": "Latest occupancy",
    "group": "ui_group_latest",
    "order": 3,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Occupancy",
    "label": "people",
    "format": "{{value}}",
    "min": 0,
    "max": 40,
    "colors": ["#1f77b4", "#2ca02c", "#ff7f0e"],
    "seg1": "10",
    "seg2": "30",
    "x": 650,
    "y": 140,
    "wires": []
  },
  {
    "id": "text_alerts",
    "type": "ui_text",
    "z": "tab_smart_campus",
    "group": "ui_group_alerts",
    "order": 1,
    "width": 6,
    "height": 2,
    "name": "Alerts text",
    "label": "Latest alert",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 620,
    "y": 190,
    "wires": []
  },
  {
    "id": "chart_temperature",
    "type": "ui_chart",
    "z": "tab_smart_campus",
    "name": "Temperature over time",
    "group": "ui_group_chart",
    "order": 1,
    "width": 12,
    "height": 5,
    "label": "Temperature over time",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for telemetry",
    "dot": false,
    "ymin": "0",
    "ymax": "50",
    "removeOlder": "30",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#1f77b4", "#2ca02c", "#ff7f0e", "#d62728"],
    "outputs": 1,
    "x": 650,
    "y": 240,
    "wires": [[]]
  }
]
